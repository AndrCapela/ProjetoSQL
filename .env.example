# Copie para .env na VPS e ajuste conforme seu domínio nip.io
APP_ENV=production
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=6
CHAT_DAILY_LIMIT_PER_USER=20
CHAT_MAX_HISTORY_MESSAGES=6

# Recomendado em produção: substitua pelo seu domínio nip.io
# Exemplo: ALLOWED_HOSTS=sql.203.0.113.10.nip.io,203.0.113.10.nip.io,localhost,127.0.0.1
ALLOWED_HOSTS=*

# Chave da API do Google Gemini (AI Studio) para o chat Tutor SQL
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=450
